# Server
PORT=8000
LOG_LEVEL=info

# Supabase PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Qdrant vector database
QDRANT_URL=https://xxxx.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=banking_knowledge

# OpenRouter (embeddings + LLM)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Internal API key (protects admin/write endpoints)
INTERNAL_API_KEY=change-me-in-production

# CORS allowed origins (comma-separated)
FRONTEND_URL=http://localhost:3000,https://your-vercel-app.vercel.app

# Background sync interval in seconds
SYNC_INTERVAL_SECONDS=60
