# ── n8n core ────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Generate a strong random string: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string

# ── n8n auth ────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# ── AI providers ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Ollama runs on your host; docker-compose maps host.docker.internal automatically
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_LEADS_DB=your_leads_database_id
NOTION_ONBOARDING_DB=your_onboarding_database_id

# ── SMTP (same creds as backend) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="RudraAI <your@gmail.com>"
CONTACT_TO=hello@rudraai.io

# ── Slack (optional) ─────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Webhook paths (these go into your backend .env) ─────────────────────────
# After importing workflows in n8n and activating them, copy the webhook URLs here:
# N8N_WEBHOOK_CONTACT=http://localhost:5678/webhook/contact-form
# N8N_WEBHOOK_CHAT=http://localhost:5678/webhook/ai-chat
# N8N_WEBHOOK_LEAD_QUALIFY=http://localhost:5678/webhook/lead-qualify
# N8N_WEBHOOK_BOOKING=http://localhost:5678/webhook/booking
