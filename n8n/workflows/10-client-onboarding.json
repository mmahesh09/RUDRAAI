{
  "name": "10 — Client Onboarding Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "onboard-client",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-onboard",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst now = new Date();\nconst kickoffDate = new Date(now.getTime() + 24 * 60 * 60 * 1000); // Tomorrow\nconst deliveryDate = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000); // 3 days\n\nreturn [{\n  json: {\n    ...body,\n    projectId: `RUDRA-${Date.now()}`,\n    startDate: now.toISOString(),\n    kickoffDate: kickoffDate.toISOString(),\n    deliveryDate: deliveryDate.toISOString(),\n  }\n}];"
      },
      "id": "setup-project",
      "name": "Setup Project Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "databasePage",
        "operation": "create",
        "databaseId": { "__rl": true, "value": "={{$env.NOTION_ONBOARDING_DB}}", "mode": "id" },
        "propertiesUi": {
          "propertyValues": [
            { "key": "Project|title", "titleValue": "={{$json.projectId}} — {{$json.company || $json.name}}" },
            { "key": "Client Name|rich_text", "textValue": "={{$json.name}}" },
            { "key": "Client Email|email", "emailValue": "={{$json.email}}" },
            { "key": "Company|rich_text", "textValue": "={{$json.company || ''}}" },
            { "key": "Plan|select", "selectValue": "={{$json.plan || 'Starter'}}" },
            { "key": "Automations|rich_text", "textValue": "={{$json.automations || $json.message || ''}}" },
            { "key": "Status|select", "selectValue": "Kickoff Scheduled" },
            { "key": "Kickoff Date|date", "dateValue": "={{$json.kickoffDate}}" },
            { "key": "Delivery Date|date", "dateValue": "={{$json.deliveryDate}}" },
            { "key": "Project ID|rich_text", "textValue": "={{$json.projectId}}" }
          ]
        }
      },
      "id": "notion-project",
      "name": "Create Project in Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [680, 200],
      "credentials": { "notionApi": { "id": "notion-creds", "name": "Notion API" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$json.email}}",
        "subject": "🚀 Welcome to RudraAI — Your automation journey starts now!",
        "emailFormat": "html",
        "message": "<div style=\"font-family:sans-serif;max-width:600px;margin:0 auto;color:#333\">\n  <div style=\"background:linear-gradient(135deg,#FF6B00,#FF8C00);padding:32px;border-radius:12px 12px 0 0;text-align:center\">\n    <h1 style=\"color:#fff;margin:0;font-size:28px\">Welcome aboard! ⚡</h1>\n    <p style=\"color:rgba(255,255,255,0.9);margin:8px 0 0\">Your automation journey starts now</p>\n  </div>\n  <div style=\"padding:32px;border:1px solid #eee;border-top:none;border-radius:0 0 12px 12px\">\n    <p>Hi {{$json.name}},</p>\n    <p>Excited to have you as a RudraAI client! Here's what happens next:</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#fff8f4\">\n        <td style=\"padding:12px;border:1px solid #ffe5d0;font-weight:bold;color:#FF6B00\">Project ID</td>\n        <td style=\"padding:12px;border:1px solid #ffe5d0;font-family:monospace\">{{$json.projectId}}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:12px;border:1px solid #eee;font-weight:bold\">Kickoff Call</td>\n        <td style=\"padding:12px;border:1px solid #eee\">{{$json.kickoffDate}}</td>\n      </tr>\n      <tr style=\"background:#f9f9f9\">\n        <td style=\"padding:12px;border:1px solid #eee;font-weight:bold\">Delivery Target</td>\n        <td style=\"padding:12px;border:1px solid #eee\">{{$json.deliveryDate}} (48-72 hrs)</td>\n      </tr>\n    </table>\n    <h3 style=\"color:#333\">Your onboarding checklist:</h3>\n    <ul style=\"line-height:1.8\">\n      <li>✅ Share access to tools we'll integrate (Slack, CRM, etc.)</li>\n      <li>✅ Review and approve the automation design doc we'll send</li>\n      <li>✅ Attend the kickoff call to confirm requirements</li>\n      <li>✅ Test the live workflow after deployment</li>\n    </ul>\n    <p style=\"color:#888;font-size:0.9em\">Questions? Reply to this email or message us on WhatsApp. We respond within 4 hours.</p>\n    <p>Let's build something great together!<br><strong>The RudraAI Team</strong></p>\n  </div>\n</div>"
      },
      "id": "welcome-email",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 400],
      "credentials": { "smtp": { "id": "smtp-creds", "name": "SMTP" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=🚀 *New Client Onboarded!*\n*Project:* {{$('Setup Project Data').item.json.projectId}}\n*Client:* {{$('Setup Project Data').item.json.name}} ({{$('Setup Project Data').item.json.email}})\n*Company:* {{$('Setup Project Data').item.json.company || 'N/A'}}\n*Plan:* {{$('Setup Project Data').item.json.plan || 'Starter'}}\n*Kickoff:* {{$('Setup Project Data').item.json.kickoffDate}}\n*Delivery:* {{$('Setup Project Data').item.json.deliveryDate}}"
            }
          ]
        },
        "options": {}
      },
      "id": "slack-onboard",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "days"
      },
      "id": "wait-checklist",
      "name": "Wait 1 Day",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$('Setup Project Data').item.json.email}}",
        "subject": "Quick reminder — access needed for your automation | RudraAI",
        "emailFormat": "html",
        "message": "<p>Hi {{$('Setup Project Data').item.json.name}},</p>\n<p>Friendly reminder to share tool access for your automation setup. This helps us stay on track for your 48-hour delivery.</p>\n<p>Reply to this email with credentials or add us as a collaborator.</p>\n<p>RudraAI Team</p>"
      },
      "id": "followup-email",
      "name": "Day 2 — Access Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1340, 300],
      "credentials": { "smtp": { "id": "smtp-creds", "name": "SMTP" } },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Setup Project Data", "type": "main", "index": 0 }]]
    },
    "Setup Project Data": {
      "main": [
        [
          { "node": "Create Project in Notion", "type": "main", "index": 0 },
          { "node": "Send Welcome Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Project in Notion": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    },
    "Notify Slack": {
      "main": [[{ "node": "Wait 1 Day", "type": "main", "index": 0 }]]
    },
    "Wait 1 Day": {
      "main": [[{ "node": "Day 2 — Access Reminder", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
