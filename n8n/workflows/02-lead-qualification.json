{
  "name": "02 — Lead Qualification Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-qualify",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-lead",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.OPENROUTER_API_KEY}}" },
            { "name": "HTTP-Referer", "value": "https://rudraai.io" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "meta-llama/llama-3.2-3b-instruct:free" },
            {
              "name": "messages",
              "value": "=[{\"role\":\"system\",\"content\":\"You are a lead qualification AI for RudraAI, an automation agency. Score the lead from 1-10 and categorize as HOT/WARM/COLD based on: budget (higher = better), message clarity (specific automation needs = better), company size, urgency. Return ONLY valid JSON: {\\\"score\\\": 7, \\\"category\\\": \\\"WARM\\\", \\\"reason\\\": \\\"...\\\", \\\"recommended_plan\\\": \\\"Growth\\\"}\"},{\"role\":\"user\",\"content\":\"Name: {{$json.body.name}}\\nEmail: {{$json.body.email}}\\nCompany: {{$json.body.company}}\\nBudget: {{$json.body.budget}}\\nMessage: {{$json.body.message}}\"}]"
            },
            { "name": "max_tokens", "value": 200 }
          ]
        },
        "options": {}
      },
      "id": "score-lead",
      "name": "Score Lead (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body ?? $('Webhook').first().json;\nconst aiResponse = $input.first().json;\n\nlet score = 5;\nlet category = 'WARM';\nlet reason = 'Default qualification';\nlet recommended_plan = 'Starter';\n\ntry {\n  const content = aiResponse.choices[0].message.content;\n  const parsed = JSON.parse(content);\n  score = parsed.score || 5;\n  category = parsed.category || 'WARM';\n  reason = parsed.reason || '';\n  recommended_plan = parsed.recommended_plan || 'Starter';\n} catch (e) {}\n\nreturn [{ json: { ...body, score, category, reason, recommended_plan, qualifiedAt: new Date().toISOString() } }];"
      },
      "id": "parse-score",
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "databasePage",
        "operation": "create",
        "databaseId": { "__rl": true, "value": "={{$env.NOTION_LEADS_DB}}", "mode": "id" },
        "propertiesUi": {
          "propertyValues": [
            { "key": "Name|title", "titleValue": "={{$json.name}}" },
            { "key": "Email|email", "emailValue": "={{$json.email}}" },
            { "key": "Company|rich_text", "textValue": "={{$json.company || ''}}" },
            { "key": "Budget|rich_text", "textValue": "={{$json.budget || ''}}" },
            { "key": "Message|rich_text", "textValue": "={{$json.message}}" },
            { "key": "Score|number", "numberValue": "={{$json.score}}" },
            { "key": "Category|select", "selectValue": "={{$json.category}}" },
            { "key": "Recommended Plan|select", "selectValue": "={{$json.recommended_plan}}" },
            { "key": "AI Reason|rich_text", "textValue": "={{$json.reason}}" },
            { "key": "Status|select", "selectValue": "New" },
            { "key": "Submitted At|date", "dateValue": "={{$json.qualifiedAt}}" }
          ]
        }
      },
      "id": "notion-create",
      "name": "Add to Notion CRM",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [900, 300],
      "credentials": { "notionApi": { "id": "notion-creds", "name": "Notion API" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SLACK_WEBHOOK_URL}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=🔔 *New Lead* — {{$('Parse Score').item.json.category}} (Score: {{$('Parse Score').item.json.score}}/10)\n*Name:* {{$('Parse Score').item.json.name}}\n*Email:* {{$('Parse Score').item.json.email}}\n*Company:* {{$('Parse Score').item.json.company || 'N/A'}}\n*Plan:* {{$('Parse Score').item.json.recommended_plan}}\n*Reason:* {{$('Parse Score').item.json.reason}}"
            }
          ]
        },
        "options": {}
      },
      "id": "slack-notify",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Score Lead (OpenRouter)", "type": "main", "index": 0 }]]
    },
    "Score Lead (OpenRouter)": {
      "main": [[{ "node": "Parse Score", "type": "main", "index": 0 }]]
    },
    "Parse Score": {
      "main": [[{ "node": "Add to Notion CRM", "type": "main", "index": 0 }]]
    },
    "Add to Notion CRM": {
      "main": [[{ "node": "Notify Slack", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
