PORT=4000
NODE_ENV=development

# Consultant display name (shown in booking confirmation emails)
CONSULTANT_NAME=Your Name

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="RudraAI <noreply@rudraai.io>"
CONTACT_TO=hello@rudraai.io

# CORS — comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000,https://rudraai.io

# Slack — booking notifications sent to your Slack channel via Incoming Webhook
# Create at: https://api.slack.com/apps → Your App → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# n8n Webhooks — copy URLs from n8n after importing & activating each workflow
N8N_WEBHOOK_CONTACT=http://localhost:5678/webhook/contact-form
N8N_WEBHOOK_NEWSLETTER=http://localhost:5678/webhook/newsletter
N8N_WEBHOOK_BOOKING=http://localhost:5678/webhook/booking
N8N_WEBHOOK_CHAT=http://localhost:5678/webhook/ai-chat

# AI providers for /api/chat route (backend calls these server-side — never exposed to browser)
OPENROUTER_API_KEY=sk-or-v1-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Zoom Integration (Server-to-Server OAuth)
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us/
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Notion Integration (Client Onboarding Database)
# Create an integration at https://www.notion.so/my-integrations
# Share your database with the integration, then copy the database ID from the URL
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Cal.com Integration (real slot availability + booking creation)
# NEVER put this key in any NEXT_PUBLIC_ env var — backend only
# Generate at: https://app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=cal_live_your_api_key_here
# Slug of your event type (find it in the Cal.com URL: /your-username/60min)
CALCOM_EVENT_SLUG=60min

# Supabase — persistent database for contacts, bookings, newsletter subscribers
# Use the service_role key (bypasses RLS). Find both in Supabase → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry — production error tracking (optional; omit to disable)
# Create a project at https://sentry.io and copy the DSN from Settings → SDK Setup
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Qdrant — vector database for RAG (optional; omit to disable /api/rag)
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# Internal API key — protects non-user-facing endpoints (e.g. /api/rag/search)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send as request header:  X-API-Key: <value>
INTERNAL_API_KEY=

# Chatwoot — live chat webhook (optional)
# Create a webhook in Chatwoot → Settings → Integrations → Webhooks
CHATWOOT_WEBHOOK_SECRET=your-chatwoot-webhook-secret

# ── Rate limiting & abuse protection ──────────────────────────────────────────
# Redis backs the sliding-window limiter (shared across horizontally-scaled
# instances). OMIT to fall back to per-process in-memory limiting — fine for a
# single instance / local dev, NOT safe across multiple instances or serverless.
# docker-compose sets this automatically to redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Proxy hops in front of the app (Vercel/Render/Cloudflare = 1). Sets Express
# `trust proxy` so req.ip is trustworthy and X-Forwarded-For can't be spoofed.
TRUST_PROXY_HOPS=1

# Per-window request ceilings (all optional — sensible defaults in config.ts)
RL_GLOBAL_MAX=100      # backstop per identity, 15 min window
RL_FORM_MAX=5          # contact/booking/newsletter, 1 hour window
RL_CHAT_MAX=20         # AI chat, 15 min window
RL_INTERNAL_MAX=120    # X-API-Key callers (RAG), 1 min window

# Progressive temp-ban tuning for repeat offenders
RL_OFFENSE_WINDOW_MS=3600000   # window over which 429s accumulate (1h)
RL_BAN_THRESHOLD=3             # offenses before the first temp ban
RL_BASE_BAN_MS=300000         # first ban length; doubles each escalation (5m)
RL_MAX_BAN_MS=86400000        # hard cap on any single ban (24h)

# Static allow/deny lists (comma-separated IPs). Whitelist bypasses all limits;
# blacklist gets a hard 403. Leave blank to disable.
RL_WHITELIST_IPS=
RL_BLACKLIST_IPS=
