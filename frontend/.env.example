# ── Backend proxy (server-side only — never sent to the browser) ──────────────
# Next.js rewrites /api/* to this URL. The browser never sees this value.
#
# Local dev:   http://localhost:4000
# Production:  https://<your-render-or-railway-url>
BACKEND_URL=http://localhost:4000

# ── Public client-side vars ───────────────────────────────────────────────────
# Your display name shown on the scheduling card and confirmation emails
NEXT_PUBLIC_CONSULTANT_NAME=Your Name


# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID — leave empty in staging/dev to avoid
# polluting production data. Only fires when set.
NEXT_PUBLIC_GA_ID=

# ── Sentry — error monitoring (optional; omit to disable) ─────────────────────
# Create a Next.js project at https://sentry.io, copy the DSN from Settings → SDK Setup
NEXT_PUBLIC_SENTRY_DSN=

# ── Chatwoot — live chat widget (optional; omit to disable) ───────────────────
# Create a Website inbox in Chatwoot → Settings → Inboxes
NEXT_PUBLIC_CHATWOOT_TOKEN=
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://app.chatwoot.com

# ── Supabase — required for client portal auth ────────────────────────────────
# From Supabase: Project Settings → API
# Public (anon) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Client portal ────────────────────────────────────────────────────────────
# The canonical frontend URL — used in invite emails and magic link redirects
NEXT_PUBLIC_SITE_URL=https://rudraai.io

# ── Sentry CLI — for source-map upload on `npm run build` (CI/CD only) ───────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Booking: Cal.com (server-side only) ───────────────────────────────────────
# Live weekend availability + real slot reservation. Without these the booking
# page runs in "request" mode (fixed weekend grid, confirmed manually by email).
CALCOM_API_KEY=
# Numeric event type ID (Cal.com → Event Types → open the 15 min event, ID is in the URL).
# Most reliable option; when empty the slug below is looked up instead.
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_SLUG=15min
# Secret for POST /api/cal/webhook (Cal.com → Settings → Developer → Webhooks).
# Subscribe to BOOKING_CREATED, BOOKING_CANCELLED, BOOKING_RESCHEDULED.
CALCOM_WEBHOOK_SECRET=

# ── Booking: Google Sheets ledger (server-side only) ─────────────────────────
# Share the spreadsheet with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
# Tab is created with headers on first booking if it doesn't exist
GOOGLE_SHEETS_BOOKINGS_TAB=Bookings
