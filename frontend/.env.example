# ── Backend proxy (server-side only — never sent to the browser) ──────────────
# Next.js rewrites /api/* to this URL. The browser never sees this value.
#
# Local dev:   http://localhost:4000
# Production:  https://<your-render-or-railway-url>
BACKEND_URL=http://localhost:4000

# ── Public client-side vars ───────────────────────────────────────────────────
# Your display name shown on the scheduling card and confirmation emails
NEXT_PUBLIC_CONSULTANT_NAME=Your Name

# Cal.com event link slug (e.g. "yourname/60min")
# Leave empty to use the built-in time-slot picker instead of Cal.com embed
NEXT_PUBLIC_CALCOM_LINK=

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID — leave empty in staging/dev to avoid
# polluting production data. Only fires when set.
NEXT_PUBLIC_GA_ID=

# ── Sentry — error monitoring (optional; omit to disable) ─────────────────────
# Create a Next.js project at https://sentry.io, copy the DSN from Settings → SDK Setup
NEXT_PUBLIC_SENTRY_DSN=

# ── Chatwoot — live chat widget (optional; omit to disable) ───────────────────
# Create a Website inbox in Chatwoot → Settings → Inboxes
NEXT_PUBLIC_CHATWOOT_TOKEN=
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://app.chatwoot.com

# ── Supabase — required for client portal auth ────────────────────────────────
# From Supabase: Project Settings → API
# Public (anon) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Client portal ────────────────────────────────────────────────────────────
# The canonical frontend URL — used in invite emails and magic link redirects
NEXT_PUBLIC_SITE_URL=https://rudraai.io

# ── Sentry CLI — for source-map upload on `npm run build` (CI/CD only) ───────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
