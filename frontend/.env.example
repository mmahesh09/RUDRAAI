# Backend API URL
# Local dev: http://localhost:4000
# Production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Consultant name shown on the scheduling card
NEXT_PUBLIC_CONSULTANT_NAME=Your Name

# Cal.com: set to your Cal.com event link (e.g. "yourname/60min")
# Leave empty to use the built-in scheduling card instead
NEXT_PUBLIC_CALCOM_LINK=
